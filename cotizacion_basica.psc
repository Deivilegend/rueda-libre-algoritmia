Algoritmo cotizacion_basica
	
	Definir nombre Como Caracter
	Definir precioHora Como Entero
	Definir Horas Como Entero
	Definir valorTotal Como Real
	
	precioHora=10000
	
	Escribir "Ingrese su nombre"
	Leer nombre
	
	Escribir "Ingrese numero de horas de alquiler"
